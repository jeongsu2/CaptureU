# 이 파일을 복사해 .env를 만들고 값을 채운다. .env는 커밋되지 않는다.
#   cp .env.example .env
#
# IG_ACCESS_TOKEN: Meta 앱 대시보드 > Instagram API > API setup with Unified login > 2. 액세스 토큰 생성
# IG_USER_ID:      같은 화면의 계정 이름 아래 숫자
IG_ACCESS_TOKEN=
IG_USER_ID=

# ANTHROPIC_API_KEY: 추천 문구를 Claude로 만들 때 쓴다 (platform.claude.com > API Keys). 비워 두면 템플릿으로 추천한다
ANTHROPIC_API_KEY=

# 인스타 로그인 (#16) — Meta 앱 대시보드 값. 시크릿은 절대 커밋하지 않는다
META_APP_ID=
META_APP_SECRET=
# 비즈니스용 Facebook 로그인 > 구성의 ID
META_LOGIN_CONFIG_ID=
# 로그인 구성의 리디렉션 URL. Meta는 HTTPS만 받아서 로컬은 https 프로필(https://localtest.me:8443/api/auth/callback)을 쓴다
# 다른 주소를 쓸 때만 넣는다
# META_REDIRECT_URI=
# 사용자 토큰 암호화 키 (32바이트 Base64). 만들기: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# 로컬 HTTPS 키 저장소(secrets/localtest.p12) 비밀번호. application-https.yml 참고
LOCAL_SSL_PASSWORD=
# 배포(HTTPS)에서는 아래처럼 둔다. 로컬 기본값: env 계정 대체 켬, Secure 쿠키 끔
# AUTH_ENV_FALLBACK=false
# SESSION_COOKIE_SECURE=true
